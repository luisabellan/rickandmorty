{
  "name": "@rickandmorty/api",
  "version": "1.0.0",
  "description": "Rick and Morty API with location filtering for the fansite monorepo",
  "main": "server.js",
  "engines": {
    "node": ">= 20.0.0"
  },
  "scripts": {
    "start": "node ./server.js",
    "dev": "nodemon ./server.js",
    "seed": "node ./scripts/seed.js",
    "test": "nyc --check-coverage --lines 95 mocha --exit && nyc report --reporter=lcov",
    "test:watch": "nodemon --ext js ./test --exec 'mocha --reporter min'",
    "test:mock": "mongorestore --host=localhost:27017 --db=rickmorty-test --drop ./test/data",
    "lint": "eslint ."
  },
  "author": "Axel Fuhrmann, Luis Abellan",
  "license": "BSD-3-Clause",
  "dependencies": {
    "@prisma/client": "^6.17.1",
    "apollo-datasource-rest": "^0.8.1",
    "apollo-server-express": "^3.13.0",
    "axios": "^1.12.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.3.0",
    "graphql": "^16.11.0",
    "graphql-depth-limit": "^1.1.0",
    "graphql-request": "^7.3.1",
    "mongoose": "^8.10.5",
    "mongoose-mongodb-errors": "0.0.2",
    "morgan": "^1.10.0",
    "prisma": "^6.17.1"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.26.0",
    "c8": "^10.1.3",
    "chai": "^4.5.0",
    "chai-http": "^5.1.2",
    "eslint": "^8.57.1",
    "eslint-config-afuh": "^0.1.31",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "mocha": "^10.8.2",
    "nodemon": "^3.1.9",
    "nyc": "^17.1.0",
    "prettier": "^3.4.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luisabellan/rickandmorty.git"
  },
  "keywords": [
    "api",
    "rick and morty",
    "graphql",
    "location-filtering"
  ],
  "bugs": {
    "url": "https://github.com/luisabellan/rickandmorty/issues"
  },
  "homepage": "https://github.com/luisabellan/rickandmorty#readme"
}
